{{> ../../common/header.hbs}}

<body class="darkTheme">
  <div id="nav-slot"></div>
  <div class="root-container article-page shuffle-article">
    <article class="markdown-content">
      <%- locals.clientData.intro %>
      <div class="shuffle-controls">
        <label for="file-upload-cia" class="button">
          Load .cia
        </label>
        <input id="file-upload-cia" accept=".cia" style="display: none;" type="file"/>
        <div class="shuffle-output" id="outputMsg-cia"></div>

        <a id="downloadLink-cia" class="shuffle-download" style="display:none" type="download" download="Pokemon_Shuffle_with_Special_Stages_DLC.cia">Download modified .cia with DLC</a>
      </div>
      <%- locals.clientData.saveInstructions %>
      <div class="shuffle-controls">
        <label for="file-upload-savedata" class="button">
          Load savedata.bin
        </label>
        <input id="file-upload-savedata" accept=".bin" style="display: none;" type="file"/>
        <div class="shuffle-output" id="outputMsg-savedata"></div>

        <a id="downloadLink-savedata" class="shuffle-download" style="display:none" type="download" download="savedata.bin">Download adapted savedata.bin</a>
      </div>
      <%- locals.clientData.outro %>
    </article>
  </div>

{{> ../../common/footer.hbs}}
